generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  displayName  String
  bio          String        @default("")
  avatarUrl    String?
  passwordHash String?       // null for accounts that only use Google / email code / phone code
  email        String?       @unique // lowercase, verified
  phone        String?       @unique // E.164, verified
  googleId     String?       @unique // Google's stable "sub" claim
  needsUsername Boolean      @default(false) // new code/Google accounts pick a handle on first sign-in
  createdAt    DateTime      @default(now())
  videos       Video[]
  likes        Like[]
  saves        Save[]
  comments     Comment[]
  commentLikes CommentLike[]
  followers    Follow[]      @relation("following")
  following    Follow[]      @relation("follower")
  views        View[]
  sent         Message[]     @relation("sent")
  received     Message[]     @relation("received")
  notices      Notice[]
  // Inbox read markers: activity / follows newer than these are "unread".
  activitySeenAt  DateTime @default(now())
  followersSeenAt DateTime @default(now())
}

model Video {
  id           String    @id @default(cuid())
  url          String
  thumbnailUrl String?
  caption      String
  hashtags     String    @default("") // space-separated, lowercase, without '#'
  audioName    String
  shares       Int       @default(0)
  baseLikes    Int       @default(0) // seeded engagement added on top of real Like rows
  baseSaves    Int       @default(0)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes        Like[]
  saves        Save[]
  comments     Comment[]
  watchViews   View[]
  messages     Message[]

  @@index([createdAt])
}

/// One viewing session of a video: how long it was watched and how many times it played to the end.
/// viewerKey is the user id when logged in, or "anon:<cookie id>" for logged-out visitors.
model View {
  id          String   @id @default(cuid())
  viewerKey   String
  userId      String?
  videoId     String
  watchMs     Int
  durationMs  Int
  completions Int      @default(0)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([viewerKey, createdAt])
  @@index([videoId])
}

model Message {
  id          String    @id @default(cuid())
  text        String    @default("")
  videoId     String?   // a shared video
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  senderId    String
  recipientId String
  sender      User      @relation("sent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("received", fields: [recipientId], references: [id], onDelete: Cascade)
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// System notifications (welcome, upload published, ...).
model Notice {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Like {
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
}

model Save {
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Comment {
  id        String        @id @default(cuid())
  text      String
  createdAt DateTime      @default(now())
  userId    String
  videoId   String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([videoId, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

/// One-time sign-in code sent by email or SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  channel    String    // "email" | "sms"
  target     String    // normalised email or E.164 phone
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  ip         String?

  @@index([channel, target, createdAt])
}

/// In-flight Google sign-in. `state` is sent to Google; `bindingHash` ties the result to the
/// browser (or app WebView) that started it, via the lt_oauth cookie.
model OAuthState {
  state        String    @id
  codeVerifier String    // PKCE
  nonce        String
  bindingHash  String
  next         String    @default("/")
  app          Boolean   @default(false) // started inside the Android app
  handoffHash  String?   // app flow: one-time token the app exchanges for a session
  userId       String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
}
