# Copy the settings you need into .env.local (not committed). Everything except DATABASE_URL is optional;
# without a provider, sign-in codes are shown on screen and printed to the server console in development.

DATABASE_URL="file:./dev.db"

# Signs session cookies and sign-in codes. Set a long random value for anything beyond local use.
AUTH_SECRET=""

# The server's public address, e.g. https://letstalk.example.com. Used for the Google redirect URI.
# Without it, the address the browser used (Host header) is used.
PUBLIC_URL=""

# --- Google sign-in -----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> Web application.
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback for dev).
# Google only accepts https addresses or localhost, so phones need the server on a public https domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email codes (SMTP) ---------------------------------------------------------------------------
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Letstalk <you@example.com>"

# --- Phone codes (Twilio SMS) ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a Twilio phone number in E.164 (+15551234567) or a Messaging Service SID.
TWILIO_FROM=""
TWILIO_MESSAGING_SERVICE_SID=""

# Country code for phone numbers typed without one (default 1 = US/Canada).
DEFAULT_PHONE_COUNTRY_CODE="1"

# Show codes on screen even in production (testing only — anyone could sign in as anyone).
# DEV_SHOW_CODES="1"
